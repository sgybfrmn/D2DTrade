# ============================================
# DAY TRADERS DASHBOARD - ENVIRONMENT CONFIG
# ============================================
# Copy this file as .env and fill in your values

# ============================================
# CLAUDE AI API
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ============================================
# SERVER CONFIG
# ============================================
PORT=3001
NODE_ENV=development

# Frontend API endpoint (for React to talk to backend)
REACT_APP_API_URL=http://localhost:3001

# ============================================
# AFFILIATE LINKS (Add your referral codes)
# ============================================
# Get these from the referral programs

# Robinhood: https://robinhood.com/referral
ROBINHOOD_REFERRAL=https://robinhood.com/referral/YOUR_CODE

# Public.com: https://public.com/referral
PUBLIC_REFERRAL=https://public.com/referral/YOUR_CODE

# Moomoo: https://moomoo.com/referral
MOOMOO_REFERRAL=https://moomoo.com/referral/YOUR_CODE

# Webull: https://webull.com/referral
WEBULL_REFERRAL=https://webull.com/referral/YOUR_CODE

# ============================================
# GOOGLE ADSENSE (For ads on dashboard)
# ============================================
# Get your Publisher ID from: https://www.google.com/adsense
GOOGLE_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx

# ============================================
# EMAIL SERVICE (For newsletters)
# ============================================
# Option 1: Gmail SMTP
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here

# Option 2: SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx

# Option 3: Mailgun
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=sandbox-xxxxxxxxxxxxxxx.mailgun.org

# ============================================
# SOCIAL MEDIA INTEGRATION
# ============================================
# Twitter/X API (Optional - for auto-posting)
TWITTER_API_KEY=xxxxxxxx
TWITTER_API_SECRET=xxxxxxxx
TWITTER_ACCESS_TOKEN=xxxxxxxx
TWITTER_ACCESS_SECRET=xxxxxxxx

# Reddit API (Optional - for auto-posting)
REDDIT_CLIENT_ID=xxxxxxxx
REDDIT_CLIENT_SECRET=xxxxxxxx
REDDIT_USERNAME=your-username
REDDIT_PASSWORD=your-password

# ============================================
# PAYMENT & ANALYTICS
# ============================================
# Stripe (For payments, if you add premium features)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Google Analytics
GOOGLE_ANALYTICS_ID=G-xxxxxxxx

# ============================================
# DATABASE (Optional - use when scaling)
# ============================================
# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dashboard

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard

# ============================================
# SECURITY
# ============================================
# JWT Secret (if you add user authentication)
JWT_SECRET=your-secret-key-here-min-32-chars

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING & DEBUGGING
# ============================================
DEBUG=true
LOG_LEVEL=info

# ============================================
# NOTIFICATION SETTINGS
# ============================================
# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ============================================
# SCHEDULING & CRON JOBS
# ============================================
# Timezone for scheduled tasks
TIMEZONE=America/New_York

# Enable/Disable background tasks
ENABLE_BACKGROUND_TASKS=true
ENABLE_CONTENT_GENERATION=true
ENABLE_OPPORTUNITY_SCANNING=true

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_CHAT=true
FEATURE_CONTENT_GENERATION=true
FEATURE_OPPORTUNITY_FINDER=true
FEATURE_ANALYTICS=true
FEATURE_EMAIL_DIGEST=true

# ============================================
# MONETIZATION SETTINGS
# ============================================
# Target monthly revenue
TARGET_MONTHLY_REVENUE=1200

# Affiliate commission estimates (for tracking)
ROBINHOOD_AVG_COMMISSION=2.50
PUBLIC_AVG_COMMISSION=1.50
MOOMOO_AVG_COMMISSION=1.50
CASHBACK_AVG_COMMISSION=3.00

# ============================================
# NOTES
# ============================================
# 1. Get Claude API key at: https://console.anthropic.com/
#    Free tier: 50k tokens/month (more than enough)
#
# 2. Affiliate links are free to set up:
#    - Robinhood: https://robinhood.com/referral
#    - Public: https://public.com/referral
#    - Moomoo: https://moomoo.com/referral
#
# 3. Google AdSense setup (5-7 days to approve):
#    - https://www.google.com/adsense
#    - Requires 1000+ monthly visitors
#
# 4. Email services (choose one):
#    - Gmail (free, rate limited)
#    - SendGrid (free tier: 100 emails/day)
#    - Mailgun (free tier: 1000 emails/month)
#
# 5. Social media APIs are optional
#    - Start with manual posting (Twitter, Reddit)
#    - Add automation later as you scale
#
# 6. NEVER commit this file with real secrets!
#    - Add to .gitignore
#    - Use GitHub Secrets for production
#
# ============================================
